      <trans-unit id="caseStudy.problem.label" datatype="html">
        <source>The problem</source>
        <target state="final">Het probleem</target>
        <context-group purpose="location">
          <context context-type="sourcefile">src/app/features/home/components/case-study/case-study.ts</context>
          <context context-type="linenumber">16</context>
        </context-group>
